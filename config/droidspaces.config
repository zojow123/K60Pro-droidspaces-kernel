# Droidspaces GKI 5.15 fragment — Redmi K60 Pro (socrates) / HyperOS 3.0
#
# 基线 config 是从本机 boot.img 的 IKCONFIG 提取的完整 .config（6962 行），
# 所以这里只列"与基线不同、必须打开"的项。每条会被 scripts/config --enable
# 写入 out/.config 和 gki_defconfig，再由 olddefconfig 解析依赖。
#
# 依据：Droidspaces Kernel-Configuration.md 的 GKI 章节（5.4~6.6 用 padding 6/7/8）

# --- IPC：必须配 SYSVIPC kABI padding 补丁，否则 bootloop ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- 命名空间 ---
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# --- 硬件访问 ---
CONFIG_DEVTMPFS=y

# --- 网络（NAT 模式增强） ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- 官方推荐项 ---
# 容器内 Docker 需要（否则 buildkit 报 unsafe procfs）
CONFIG_USER_NS=y
# NAT66
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
# macvlan 网络模式
CONFIG_MACVLAN=y
# UFW（本基线 IP_NF_TARGET_REJECT / IP6_NF_TARGET_REJECT 已是 y；
# 官方写的 NETFILTER_XT_TARGET_REJECT 符号在 5.15 树中不存在）
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
# Fail2ban
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
# NixOS（tmpfs xattr / posix acl）
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- 必须关闭 ---
# 基线里 CONFIG_UNUSED_KSYMS_WHITELIST 指向小米构建机的绝对路径
#   /mnt/disks/build-disk/src/android/common-android13-5.15-2025-12/.../abi_symbollist.raw
# 该文件在本环境不存在。关闭裁剪后导出全部 EXPORT_SYMBOL，vendor 模块不会缺符号，
# 代价只是 Image 大几 MB。
CONFIG_TRIM_UNUSED_KSYMS=n

# --- 刻意不开启（破坏 kABI → vendor 模块拒载 → bootloop） ---
# CONFIG_CFS_BANDWIDTH=y     # --cpus，改 scheduler 结构，约 4000 个导出符号 CRC 变化
# CONFIG_CGROUP_PIDS=y       # --pids-limit，同上

# --- 暂不开启（非必需，等 Check Requirements 报告再决定） ---
# CONFIG_CGROUP_DEVICE=y     # 官方 GKI 清单未列，改 cgroup 结构有 ABI 风险
# CONFIG_NF_TABLES=y         # 官方 GKI 清单未列，Droidspaces 走 iptables/xt
# CONFIG_BRIDGE_NETFILTER=y  # 同上